{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceRewriterVoiceAnalysis",
  "description": "Detailed qualitative and rhetorical analysis with confidence scores.",
  "type": "object",
  "required": [
    "analysis_summary",
    "rhetorical_devices",
    "syntactic_tendencies",
    "discourse_markers"
  ],
  "properties": {
    "analysis_summary": { "type": "string" },
    "rhetorical_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "confidence", "supporting_transcripts"],
        "properties": {
          "pattern": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "supporting_transcripts": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "syntactic_tendencies": { "type": "object" },
    "discourse_markers": { "type": "object" }
  }
}
