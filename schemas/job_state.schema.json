{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceRewriterJobState",
  "description": "Global job state schema for the Voice-Rewriter pipeline, separating Job Lifecycle from Queue Lifecycle.",
  "type": "object",
  "required": [
    "job_id",
    "status",
    "current_stage",
    "iteration",
    "max_iterations",
    "failure_count",
    "max_failures",
    "created_at",
    "updated_at",
    "voice_model_bundle_path",
    "calibration_manifest_path"
  ],
  "additionalProperties": true,
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the job."
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "ingestion",
        "voice_profiling",
        "semantic_extraction",
        "writing",
        "ci_validation",
        "review",
        "evaluation",
        "controller",
        "human_approval",
        "completed"
      ],
      "description": "The active functional stage of the job."
    },
    "status": {
      "type": "string",
      "enum": [
        "WAITING_FOR_TRANSCRIPT",
        "SEMANTIC_EXTRACTION_PENDING",
        "SEMANTIC_EXTRACTION_COMPLETED",
        "WRITING_PENDING",
        "CANDIDATE_GENERATED",
        "CI_PENDING",
        "CI_PASSED",
        "CI_FAILED",
        "REVIEW_PENDING",
        "REVIEW_COMPLETED",
        "EVALUATION_PENDING",
        "EVALUATED",
        "ITERATING",
        "NEEDS_HUMAN_REVIEW",
        "READY_FOR_HUMAN_APPROVAL",
        "APPROVED_BY_HUMAN",
        "PROMOTED",
        "FAILED"
      ],
      "description": "Strict Job Lifecycle state. PROMOTED is the terminal success state; FAILED is the terminal failure state."
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "description": "Current iteration counter (1-indexed)."
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "default": 5,
      "description": "Maximum number of allowed writing/evaluation iterations."
    },
    "failure_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of consecutive pipeline or worker failures."
    },
    "max_failures": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Maximum failure threshold before circuit breaker trips to NEEDS_HUMAN_REVIEW."
    },
    "voice_model_bundle_path": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable frozen path to the Voice Model Bundle version used for this job."
    },
    "calibration_manifest_path": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable frozen path to the calibration manifest used for evaluating this job."
    },
    "global_artifacts": {
      "type": "object",
      "description": "Map of global artifact paths produced across stages."
    },
    "circuit_breaker": {
      "type": "object",
      "properties": {
        "minimum_voice_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "minimum_factual_fidelity": { "type": "number", "minimum": 0, "maximum": 10 },
        "maximum_source_contamination": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "description": "ISO-8601 last updated timestamp."
    }
  }
}
