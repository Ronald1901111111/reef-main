{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceRewriterLintReport",
  "description": "Deterministic lint verification report for candidate text.",
  "type": "object",
  "required": [
    "job_id",
    "candidate_version",
    "voice_model_version",
    "status",
    "violations",
    "warnings",
    "metrics",
    "generated_at"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "candidate_version": { "type": "string" },
    "voice_model_version": { "type": "string" },
    "status": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "required": ["max_sentence_length", "long_sentences_count"],
      "properties": {
        "max_sentence_length": { "type": "integer" },
        "long_sentences_count": { "type": "integer" }
      }
    },
    "generated_at": { "type": "string" }
  }
}
